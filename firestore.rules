rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logueado() {
      return request.auth != null;
    }
    function esDueno(uid) {
      return logueado() && request.auth.uid == uid;
    }
    // Administrador = existe el documento admins/{uid} (solo editable en la consola).
    function esAdmin() {
      return logueado()
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if esDueno(uid);
      allow write: if false;
    }

    // Catálogo de unidades: lectura para usuarios con sesión.
    // - Cualquiera con sesión puede CREAR una unidad que no existe (siembra inicial).
    // - Solo un administrador puede MODIFICAR una existente (imagen o migración).
    // - Nunca se puede borrar.
    match /unidades/{id} {
      allow read: if logueado();
      allow create: if logueado()
                    && request.resource.data.versionCatalogo is int;
      allow update: if esAdmin();
      allow delete: if false;
    }

    // Datos privados: cada usuario solo accede a lo suyo.
    match /usuarios/{uid} {
      allow read, write: if esDueno(uid);

      match /progreso/{id} {
        allow read, write: if esDueno(uid);
      }

      // Pedidos de la tienda: se pueden crear y leer, nunca editar ni borrar.
      match /pedidos/{id} {
        allow read: if esDueno(uid);
        allow create: if esDueno(uid)
                      && request.resource.data.total is int
                      && request.resource.data.total > 0;
        allow update, delete: if false;
      }
    }
  }
}
